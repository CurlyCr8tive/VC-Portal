{
  "name": "vc-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Static Verified Consulting portal with owner and client Express APIs.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-build.mjs",
    "start:owner-api": "npm --prefix server/owner-api start",
    "start:client-api": "npm --prefix server/client-api start",
    "serve:frontend": "python3 -m http.server 8420",
    "serve:static": "python3 -m http.server 8420",
    "start:local": "node scripts/start-local-stack.mjs",
    "install:apis": "npm --prefix server/owner-api ci && npm --prefix server/client-api ci",
    "demo:deck": "node scripts/build-demo-day-deck.js",
    "demo:gaps": "node scripts/invent-demo-day-gaps.mjs",
    "demo:gaps:revert": "node scripts/revert-demo-day-gaps.mjs",
    "data:seed": "node scripts/seed-supabase-from-case-studies.mjs",
    "data:fix-placement-links": "node scripts/fix-placement-links.mjs",
    "data:apply-outlet-rates": "node scripts/apply-outlet-rates-to-placements.mjs",
    "data:backfill-audience-reach": "node scripts/backfill-audience-reach.mjs",
    "data:seed-greyz-coaching": "node scripts/seed-greyz-coaching-supabase.mjs",
    "handoff:check-real": "node scripts/check-real-handoff.mjs",
    "test:local-user-flow": "node scripts/local-user-flow-check.mjs",
    "auth:provision-test-accounts": "node scripts/provision-test-accounts.mjs",
    "auth:set-owner-password": "node scripts/set-owner-password.mjs"
  }
}
