# Copy to .env and fill in once a real Supabase project exists (same
# project as owner-api — see that service's .env.example for how it's
# created).

SUPABASE_URL=
# Same service_role key as owner-api. This backend still enforces
# pr_client-only + client_id scoping itself (requireClient in
# lib/supabaseClient.js) before ever touching data with it.
SUPABASE_SERVICE_ROLE_KEY=

CLIENT_API_PORT=4002

# --- Gmail notification (owner gets emailed when a client posts a note) ---
# All four of these are required together, or the mailer no-ops (see
# lib/gmailNotify.js) rather than failing the note itself.
#
# How to get these — none of it can be generated in advance, it's a
# one-time manual setup by whoever owns the sending Google account:
#   1. Google Cloud Console -> new project -> enable the Gmail API.
#   2. OAuth consent screen -> OAuth client ID (type: Desktop app is
#      simplest for a one-time token grab).
#   3. Authorize that OAuth client against the sending Gmail account once
#      (e.g. via Google's OAuth 2.0 Playground, https://developers.google.com/oauthplayground,
#      using scope https://www.googleapis.com/auth/gmail.send) to get a
#      refresh token. Refresh tokens don't expire under normal use, so this
#      is a one-time step, not a per-deploy one.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Where the "a client posted a note" notification should land.
GMAIL_NOTIFY_TO=tenyse@verifiedconsulting.com
