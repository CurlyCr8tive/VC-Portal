# Copy to .env and fill in once a real Supabase project exists.
# The project must be created under Tenyse's own Supabase account/payment
# method, not the builder's — see the PRD's Account Ownership section.

# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# The "service_role" key, NOT "anon" — this backend enforces its own
# owner-only check (requireOwner in lib/supabaseClient.js) and needs to
# read/write across all clients. Never expose this key to any frontend.
SUPABASE_SERVICE_ROLE_KEY=

OWNER_API_PORT=4001
