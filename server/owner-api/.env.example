# Copy to .env and fill in once a real Supabase project exists.
# The project must be created under Tenyse's own Supabase account/payment
# method, not the builder's — see the PRD's Account Ownership section.

# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# The "service_role" key, NOT "anon" — this backend enforces its own
# owner-only check (requireOwner in lib/supabaseClient.js) and needs to
# read/write across all clients. Never expose this key to any frontend.
SUPABASE_SERVICE_ROLE_KEY=

OWNER_API_PORT=4001

# Deployed static frontend's origin — used to build the redirect link in
# invite emails (POST /api/clients/:clientId/invite -> set-up-account.html).
# Local dev default matches the static server's actual port; update once
# real hosting exists.
APP_BASE_URL=http://localhost:8420

# Discovery Agent, layer 1 — structured search (server/owner-api/lib/
# newsSearch.js). Set either or both; each is independent, results get
# merged and deduped by URL. Both are free, no card required.
# Currents API: https://currentsapi.services/en/register
CURRENTS_API_KEY=
# NewsData.io: https://newsdata.io/register
NEWSDATA_API_KEY=

# Discovery Agent, layer 2 — broader AI web-search sweep, runs after layer
# 1 (server/owner-api/lib/webSearchDiscovery.js). Optional: the scan still
# works on layer 1 alone if neither of these is set. COSTS REAL MONEY PER
# CALL once it runs — Claude web search is $10/1,000 searches + token
# costs, GPT web search is $10-35/1,000 calls + token costs depending on
# search_context_size. Every call is logged to
# server/owner-api/data/search-usage-log.jsonl regardless of outcome — see
# lib/searchUsageLog.js — so usage is traceable, not a surprise later.
#
# Also used by the AI writing functions (server/owner-api/lib/aiClient.js)
# — Claude tried first, GPT as fallback there too. Missing ones are
# skipped, not errors, until every provider is exhausted.
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AVE Calculation Agent's manual-fallback research only (server/owner-api/
# lib/perplexityResearch.js) — never used by the Discovery Agent.
# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
